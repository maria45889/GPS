<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!--
                CATEGORY_INFO, y NO CATEGORY_LAUNCHER: el icono del cajón lo lleva el
                activity-alias .LauncherAlias de abajo, que es el componente que
                LauncherVisibility deshabilita una vez configurado el dispositivo.

                Este filtro existe para que PackageManager.getLaunchIntentForPackage()
                siga resolviendo a MainActivity. Ese método consulta MAIN + CATEGORY_INFO,
                y el plugin de geolocalización lo usa para construir el contentIntent de
                la notificacion de foreground: si nadie resolviera el intent de launch,
                la notificacion se quedaria sin contentIntent y tocarla no abriria la app.
                Con solo CATEGORY_DEFAULT el filtro tambien casaria con MAIN + LAUNCHER y
                el icono reapareceria, porque el match de IntentFilter cortocircuita en
                cuanto encuentra CATEGORY_DEFAULT.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gpstracker" android:host="activate" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.gpstracker.com" android:pathPrefix="/activate" />
            </intent-filter>

        </activity>

        <!--
            Unica entrada MAIN + LAUNCHER del paquete, y por tanto el unico componente
            del cajon de aplicaciones. Se declara aparte de MainActivity para poder
            desactivarlo con PackageManager.setComponentEnabledSetting() sin tocar la
            Activity: MainActivity sigue siendo arrancable por BootReceiver y
            AlarmRecoveryReceiver (intents explicitos), por los deep links y por el
            toque en la notificacion de tracking. Deshabilitar MainActivity en su lugar
            los dejaria todos rotos con ActivityNotFoundException.
        -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/title_activity_main"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <!-- BootReceiver: auto-inicia el plugin de Capacitor tras reinicio del dispositivo -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- AlarmRecoveryReceiver: recuperación de servicio cuando el BootReceiver no pudo iniciar -->
        <receiver
            android:name=".AlarmRecoveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gps.tracker.ACTION_RECOVER_SERVICE" />
            </intent-filter>
        </receiver>

        <!--
            NativeTrackingService: rastreo GPS real en foreground, independiente del
            WebView. Android 10+ bloquea abrir MainActivity desde background, asi que
            el servicio tiene que emitir las posiciones por su cuenta. Este es el
            unico camino que sobrevive a un reinicio del dispositivo.
        -->
        <service
            android:name=".NativeTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Override for the background geolocation service to not be exported -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:replace="android:exported"
            android:foregroundServiceType="location" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
